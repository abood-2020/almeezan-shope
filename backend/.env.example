# Copy to backend/.env. Do not commit backend/.env.

DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Hebron

# Browser origins allowed to call the API with cookies.
# DJANGO_* names are preferred. CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS still work.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional single origin used when the lists above are empty.
# FRONTEND_URL=http://127.0.0.1:5173

# sqlite keeps the local db.sqlite3 file. postgresql reads the variables below.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

DJANGO_USE_HTTPS=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
# Set only after HTTPS is confirmed on the real server, for example 31536000.
# SECURE_HSTS_SECONDS=

# Production sketch. Replace placeholders on the server. Do not commit real values.
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=app.example
# FRONTEND_URL=https://app.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.example
# DB_ENGINE=postgresql
# DB_NAME=riwaq
# DB_USER=riwaq
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DJANGO_USE_HTTPS=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
