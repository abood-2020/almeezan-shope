# Public Django API origin. This value is baked into the frontend at build time.
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Production: set the public API origin before `corepack pnpm build`.
# Use the same site as the shop when Nginx proxies /api/ to Django, for example:
# NEXT_PUBLIC_API_BASE_URL=https://example.com
